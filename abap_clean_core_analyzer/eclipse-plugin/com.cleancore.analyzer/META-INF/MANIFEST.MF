Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: ABAP Clean Core Analyzer
Bundle-SymbolicName: com.cleancore.analyzer;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.cleancore.analyzer.Activator
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.ui.editors,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.ui.ide,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.ui.navigator;resolution:=optional,
 org.eclipse.ui.views;resolution:=optional,
 com.sap.adt.tools.core;resolution:=optional,
 com.sap.adt.communication;resolution:=optional,
 com.sap.adt.tools.abapsource;resolution:=optional
Bundle-RequiredExecutionEnvironment: JavaSE-11
Automatic-Module-Name: com.cleancore.analyzer
Bundle-ActivationPolicy: lazy
Export-Package: com.cleancore.analyzer.core
