<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.commands">
      <command
            id="com.cleancore.analyzer.analyzeCommand"
            name="Analyze for Clean Core"
            description="Analyze active ABAP editor for Clean Core compliance">
      </command>
      <command
            id="com.cleancore.analyzer.analyzePackageCommand"
            name="Analyze Package for Clean Core"
            description="Recursively analyze a SAP package and all its child packages / objects (Classes, Programs, Function Modules, Includes)">
      </command>
      <command
            id="com.cleancore.analyzer.inspectSelectionCommand"
            name="Inspect Selection (Clean Core Diagnostic)"
            description="Shows the actual Java class, adapters and getters of the currently selected Project Explorer node. Use this when 'Analyze Package' cannot read children.">
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.cleancore.analyzer.analyzeCommand"
            class="com.cleancore.analyzer.handlers.AnalyzeHandler">
      </handler>
      <handler
            commandId="com.cleancore.analyzer.analyzePackageCommand"
            class="com.cleancore.analyzer.handlers.PackageAnalyzeHandler">
      </handler>
      <handler
            commandId="com.cleancore.analyzer.inspectSelectionCommand"
            class="com.cleancore.analyzer.handlers.InspectSelectionHandler">
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="com.cleancore.analyzer.menu"
               label="Clean Core">
            <command
                  commandId="com.cleancore.analyzer.analyzeCommand"
                  label="Analyze Current File"
                  style="push">
            </command>
            <command
                  commandId="com.cleancore.analyzer.analyzePackageCommand"
                  label="Analyze Selected Package / Objects"
                  style="push">
            </command>
            <command
                  commandId="com.cleancore.analyzer.inspectSelectionCommand"
                  label="Inspect Selection (Diagnostic)"
                  style="push">
            </command>
         </menu>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="com.cleancore.analyzer.analyzeCommand"
               label="Analyze for Clean Core"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeEditor">
                  <instanceof value="org.eclipse.ui.IEditorPart"/>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="com.cleancore.analyzer.analyzePackageCommand"
               label="Analyze Package for Clean Core"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="+"/>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="com.cleancore.analyzer.inspectSelectionCommand"
               label="Inspect Selection (Clean Core Diagnostic)"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="+"/>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="com.cleancore.analyzer.analyzeCommand"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Ctrl+Shift+K">
      </key>
      <key
            commandId="com.cleancore.analyzer.analyzePackageCommand"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Ctrl+Shift+L">
      </key>
      <key
            commandId="com.cleancore.analyzer.inspectSelectionCommand"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Ctrl+Shift+I">
      </key>
   </extension>

   <extension point="org.eclipse.ui.views">
      <category
            id="com.cleancore.analyzer.viewCategory"
            name="Clean Core Analyzer">
      </category>
      <view
            id="com.cleancore.analyzer.resultView"
            name="Clean Core Analysis Results"
            class="com.cleancore.analyzer.ui.CleanCoreResultView"
            category="com.cleancore.analyzer.viewCategory"
            allowMultiple="false">
      </view>
   </extension>

</plugin>
